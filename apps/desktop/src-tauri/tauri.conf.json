{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Merka Desktop",
  "version": "0.1.0",
  "identifier": "cloud.merka.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Merka Desktop",
        "width": 960,
        "height": 760,
        "minWidth": 360,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Configure Merka services on this computer"
  }
}
